    { t: "구조화된 답", d: "핵심 한 줄 → 직관 → 정의와 식 → 작은 예시 → 자주 하는 오해 순서로 정리해요." },
    { t: "더 쉽게 · 더 자세히", d: "어려우면 ‘더 쉽게’, 부족하면 ‘더 자세히’로 이어서 물어봐요." },
  ]}
  can={[
    "대학 이공계 전공 개념 전반",
    "수식이 들어간 정의와 예시를 조판된 수식으로",
    "질문과 답은 내 iCloud에 저장돼 나중에 다시 보기",
  ]}
  cannot={[
    "개념 질문의 답은 문제 해설처럼 별도 AI 검증을 거치지 않아요. 중요한 정의는 교재와 함께 확인하세요.",
    "특정 교재의 쪽수나 강의 내용을 알지는 못해요.",
  ]}
  cost="개념 질문 1개는 1크레딧이에요. 질문 내용과 첨부 사진은 답을 만들기 위해서만 전송되고 회사 서버에는 저장되지 않아요."
  faq={[
    { q: "학습 라이브러리와 무엇이 다른가요?", a: "학습 라이브러리는 정답을 수식 계산으로 다시 확인해 공개한 개념·예제 해설이고, 개념 질문은 내 궁금증에 맞춰 바로 답을 받는 기능이에요. 라이브러리에서 기본을 보고, 남는 질문을 앱에서 물어보면 좋아요." },
  ]}
  related={[
    { href: "/learn/", label: "무료 학습 라이브러리" },

---
/**
 * Every page goes through here, so every page gets: a unique title and
 * description, an absolute canonical, Open Graph, the search engine ownership
 * tags, Organization/WebSite JSON-LD, and the same nav and footer.
 */
import "../styles/global.css";
import { SITE, absoluteUrl } from "../config/site";
import { organizationLd, websiteLd } from "../lib/jsonld";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";

interface Props {
  /** Page title without the brand suffix. The home page passes `fullTitle` instead. */
  title?: string;
  fullTitle?: string;
  description: string;
  /** Site-relative path used for the canonical, e.g. "/pricing/". Defaults to the request path. */
  path?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** Section of the site for nav highlighting. */
  section?: "features" | "learn" | "pricing" | "faq" | "guides" | "about";
  /** Campaign code for the page's App Store links (see appStoreUrl). */
  campaign?: string;
  stickyCta?: boolean;
}

const {
  title,
  fullTitle,
  description,
  path = Astro.url.pathname,
  ogImage = SITE.defaultOgImage,
  ogType = "website",
  noindex = false,
  jsonLd = [],
  section,
  campaign = "web_other",
  stickyCta = true,
} = Astro.props;

const pageTitle = fullTitle ?? `${title} | Qlip`;
const canonical = absoluteUrl(path.replace(/index\.html$/, ""));
const ogImageUrl = absoluteUrl(ogImage);
const ld = [organizationLd(), websiteLd(), ...jsonLd];
const v = SITE.verification;
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
{v.naver && <meta name="naver-site-verification" content={v.naver} />}
{v.google && <meta name="google-site-verification" content={v.google} />}
{v.bing && <meta name="msvalidate.01" content={v.bing} />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="Qlip" />
<meta property="og:locale" content="ko_KR" />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- iOS Safari offers the app at the top of the page. -->
<meta name="apple-itunes-app" content={`app-id=${SITE.appStore.id}`} />
<meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0C0C14" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png" />
<link rel="apple-touch-icon" href="/assets/img/favicon-180.png" />
<link rel="alternate" type="application/rss+xml" title="Qlip 학습 라이브러리" href="/rss.xml" />
<slot name="head" />
{ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
{SITE.ga4Id && (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
    <script is:inline define:vars={{ id: SITE.ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", id);
    </script>
  </>
)}
</head>
<body>
<a class="skip-link" href="#main">본문으로 건너뛰기</a>
<Nav section={section} campaign={campaign} />
<main id="main">
  <slot />
</main>
<Footer />
{stickyCta && <StickyCta campaign={`${campaign}_sticky`} />}
<script>
  // Download clicks and FAQ opens, sent to GA4 when it is configured. Links
  // carry data-track / data-loc, so markup decides what is measured.
  type Gtag = (...args: unknown[]) => void;
  const send = (name: string, params: Record<string, string>) => {
    const g = (window as unknown as { gtag?: Gtag }).gtag;
    if (g) g("event", name, { ...params, page_path: location.pathname });
  };
  document.addEventListener("click", (e) => {
    const el = (e.target as Element | null)?.closest<HTMLElement>("[data-track]");
    if (el) send(el.dataset.track!, { location: el.dataset.loc ?? "" });
  });
  document.querySelectorAll<HTMLDetailsElement>("details[data-track-open]").forEach((d) => {
    d.addEventListener("toggle", () => { if (d.open) send(d.dataset.trackOpen!, { item: d.dataset.item ?? "" }); });
  });
</script>
</body>
</html>

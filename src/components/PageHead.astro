---
interface Props { crumbs: { name: string; path: string }[]; eyebrow?: string; h1: string; lead?: string }
const { crumbs, eyebrow, h1, lead } = Astro.props;
---
<header class="page-head notebook">
  <div class="container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <ol>
        {crumbs.map((c, i) => (
          <li>{i < crumbs.length - 1 ? <a href={c.path}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</li>
        ))}
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{h1}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
